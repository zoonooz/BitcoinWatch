[
  {
    "type": "heading",
    "defaultValue": "WatchFace Configuration"
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Service"
      },
      {
        "type": "select",
        "messageKey": "service",
        "defaultValue": "coinbase",
        "label": "Price service",
        "options": [
          {
            "label": "Coinbase",
            "value": "coinbase"
          },
          {
            "label": "Binance",
            "value": "binance"
          }
        ]
      },
      {
        "type": "input",
        "messageKey": "currencyBase",
        "defaultValue": "BTC",
        "label": "Base",
        "attributes": {                                                                                                                            
          "style": "text-transform: uppercase"                                                                                                     
        }   
      },
      {
        "type": "input",
        "messageKey": "currencyQuote",
        "defaultValue": "USD",
        "label": "Quote",
        "attributes": {                                                                                                                            
          "style": "text-transform: uppercase"                                                                                                     
        }    
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Chart"
      },
      {
        "type": "toggle",
        "messageKey": "chartEnabled",
        "label": "Show price chart",
        "defaultValue": true
      },
      {
        "type": "select",
        "messageKey": "chartRange",
        "defaultValue": "24h",
        "label": "Time range",
        "options": [
          { "label": "1 hour", "value": "1h" },
          { "label": "6 hours", "value": "6h" },
          { "label": "24 hours", "value": "24h" },
          { "label": "7 days", "value": "7d" }
        ]
      },
      {
        "type": "select",
        "messageKey": "chartStyle",
        "defaultValue": "line",
        "label": "Chart style",
        "options": [
          { "label": "Line", "value": "line" },
          { "label": "Candles", "value": "candles" }
        ]
      }
    ]
  },
  {
    "type": "submit",
    "defaultValue": "Save Settings"
  }
]
