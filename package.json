{
  "author": "zoonref@gmail.com",
  "dependencies": {
    "pebble-clay": "^1.0.2"
  },
  "keywords": [],
  "name": "BitcoinWatch2",
  "pebble": {
    "displayName": "BitcoinWatch2",
    "enableMultiJS": true,
    "messageKeys": [
      "price",
      "status",
      "action",
      "service",
      "currencyBase",
      "currencyQuote",
      "chart",
      "chartEnabled",
      "chartRange",
      "chartStyle"
    ],
    "projectType": "native",
    "resources": {
      "media": []
    },
    "sdkVersion": "3",
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery"
    ],
    "uuid": "cc505d9e-2b61-4028-bb50-5cd864f323f2",
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable"
    ],
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.binance.com",
            "api.coinbase.com",
            "api.exchange.coinbase.com"
          ]
        }
      }
    ]
  },
  "version": "2.0.1"
}
